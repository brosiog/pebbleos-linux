# Galaxy Watch3 SM-R850: native PebbleOS with Linux hardware backends.
CONFIG_LINUX_WATCH=y
CONFIG_ORIENTATION_MANAGER=y
# Themes: accent color and dark mode, which saves power on the OLED panel.
CONFIG_THEMING=y
CONFIG_DISPLAY_SDL=n
CONFIG_DISPLAY_LINUX_FB=y
CONFIG_BUTTON_SDL=n
CONFIG_BUTTON_LINUX_EVDEV=y
CONFIG_TOUCH_SDL=n
CONFIG_TOUCH_LINUX_EVDEV=y
CONFIG_MODDABLE_XS=n
CONFIG_SAMSA_CACHE_ENTRIES=1024
CONFIG_BATTERY_POSIX=n
CONFIG_BATTERY_LINUX=y
CONFIG_BT_HCI_FAKE=n
CONFIG_BT_HCI_LINUX=y
# Broadcom vendor events can use the full 255-byte HCI event payload.
CONFIG_NIMBLE_BLE_TRANSPORT_EVT_SIZE=257
# Phones burst ACL data while rediscovering services after a reconnect.
CONFIG_NIMBLE_BLE_TRANSPORT_ACL_FROM_LL_COUNT=24

CONFIG_AMBIENT_LIGHT_BITS=16
CONFIG_DYNAMIC_BACKLIGHT=y
CONFIG_ACCEL_LINUX_WATCH=y
CONFIG_SERVICE_ACCEL_MANAGER_BATCH_SAMPLES=125
CONFIG_SERVICE_ACTIVITY_BATCH_SAMPLES=125
CONFIG_HRM=y
CONFIG_HRM_LINUX_WATCH=y
CONFIG_MIC_LINUX=y
CONFIG_MIC_QEMU=n
